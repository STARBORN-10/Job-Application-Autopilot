# ===========================================================================
# Job Application Autopilot - Backend Environment Configuration Template
# ---------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env' in this backend/ directory.
# 2. Fill in the keys you have; every feature without its key is skipped with a clear message.
# 3. NEVER commit real secrets or credentials to Git.
# ===========================================================================

# Database connection URL:
# Local development default (SQLite):
DATABASE_URL=sqlite:///./jobs.db
# Production (e.g. Render PostgreSQL / Supabase / Neon):
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# ---------------------------------------------------------------------------
# Python Automation Pipeline Configuration
# ---------------------------------------------------------------------------
# RapidAPI Key for JSearch job discovery (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch):
RAPIDAPI_KEY=your_rapidapi_key_here

# Google Gemini API Key for job-candidate match evaluation and cover letters:
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override. New keys can't use gemini-2.5-flash; gemini-3.5-flash-lite works on free keys.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Telegram Bot configuration for job alerts (TELEGRAM_CHAT_ID is the only chat whose button taps are obeyed):
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional built-in scheduler: run the pipeline automatically every N minutes (0/unset = disabled).
# Needs an always-on host (not a sleeping free tier) - see docs/deployment.md.
# AUTO_RUN_INTERVAL_MINUTES=360

# Retry behaviour for transient API errors (timeouts, rate limits):
# RETRY_MAX_ATTEMPTS=3
# RETRY_BASE_DELAY_SECONDS=1.5

# Port (optional, default 8000):
# PORT=8000

# CORS: comma-separated allowed origins (unset = allow all). FRONTEND_URL (your deployed dashboard) is
# always added, and http://localhost:<any port> / http://127.0.0.1:<any port> are always allowed for dev.
# CORS_ORIGINS=https://your-dashboard.vercel.app
# FRONTEND_URL=https://your-dashboard.vercel.app

# ---------------------------------------------------------------------------
# V2: more job sources (each is optional; a source without its key is skipped)
# ---------------------------------------------------------------------------
# Adzuna India (free key: https://developer.adzuna.com/)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
# Jooble India (free key: https://jooble.org/api/about)
JOOBLE_API_KEY=your_jooble_api_key_here
# JSearch free plan = 200 requests/month; the app stops at this many per calendar month:
# JSEARCH_MONTHLY_BUDGET=150
# Pause between company career board requests (Greenhouse/Lever/Ashby; no key needed):
# ATS_REQUEST_DELAY_SECONDS=0.5
# Cache for the experimental Internshala scraper (off by default; enable it in Settings):
# INTERNSHALA_CACHE_HOURS=6

# ---------------------------------------------------------------------------
# V2: AI providers (at least one key; tried in this order, falling through on errors)
# ---------------------------------------------------------------------------
# LLM_PROVIDER_ORDER=gemini,groq,openrouter
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL_EXTRACT=openai/gpt-oss-20b
# GROQ_MODEL_WRITE=openai/gpt-oss-120b
# GROQ_MAX_WAIT_SECONDS=20
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Jobs per run that get AI facts and cover letters (the rest keep the keyword score):
# LLM_MAX_JOBS_PER_RUN=15
# Decisions needed before weight tuning is offered:
# TUNE_MIN_DECISIONS=30

# ---------------------------------------------------------------------------
# V2: Telegram approve/skip buttons
# ---------------------------------------------------------------------------
# Random string; Telegram sends it back on every webhook call (needed for the webhook):
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_here
# Public https URL of this backend, used by POST /api/telegram/set-webhook:
# PUBLIC_BACKEND_URL=https://your-backend.onrender.com
# Local development without a public URL: poll Telegram instead of using the webhook:
# TELEGRAM_MODE=polling

# ---------------------------------------------------------------------------
# V2: protection
# ---------------------------------------------------------------------------
# When set, approve/skip/apply, set-webhook and weight tuning need the header X-Admin-Key.
ADMIN_API_KEY=your_random_admin_key_here
# Minimum seconds between manual pipeline starts:
# TRIGGER_COOLDOWN_SECONDS=120

# ---------------------------------------------------------------------------
# V2: safe applying (only ever after you approve a job)
# ---------------------------------------------------------------------------
# true (default) = log what would be sent, send nothing. Set to false to really e-mail recruiters.
APPLY_DRY_RUN=true
# APPLY_DAILY_CAP=10
# SMTP for e-mail applications. Gmail: smtp.gmail.com, port 465 and an App Password
# (Google Account > Security > 2-Step Verification > App passwords), not your normal password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_app_password_here
# SMTP_FROM=you@gmail.com

# ---------------------------------------------------------------------------
# V2.5: tailored resume per job (on Approve and the "Tailor resume" button)
# ---------------------------------------------------------------------------
# Jobs scoring at or above this keep the original resume unchanged:
# TAILOR_SCORE_THRESHOLD=9.0
# Generate a tailored resume automatically when you approve a job (true/false):
# AUTO_TAILOR_ON_APPROVE=true
# Where tailored resumes and form screenshots are written (default: backend/generated, git-ignored):
# GENERATED_DIR=

# ---------------------------------------------------------------------------
# V2.5: career-page form filling (Greenhouse / Lever / Ashby). Optional: needs
#   pip install -r requirements-optional.txt  and  python -m playwright install chromium
# ---------------------------------------------------------------------------
# prefill = fill the form and stop (the only mode):
# AUTOFILL_MODE=prefill
# Start pre-filling automatically when you approve a Greenhouse/Lever/Ashby job:
# AUTOFILL_ON_APPROVE=true
# Submit automatically ONLY when this is true AND APPLY_DRY_RUN=false AND the job is approved AND every
# required field is filled AND there is no CAPTCHA. Default false: you review and click Submit yourself.
# AUTOFILL_SUBMIT=false
# false = open a visible browser window (local use) and leave it open so you can review and submit:
# AUTOFILL_HEADLESS=true
# AUTOFILL_KEEP_OPEN_MINUTES=20
# AUTOFILL_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------------------
# DEPRECATED: legacy ingestion API (POST /api/jobs, GET /api/make/*), from the old Make.com setup.
# The built-in pipeline replaced it; set this only if an external script still pushes jobs in.
# Requests must send the header X-API-Key with this value.
# ---------------------------------------------------------------------------
# MAKE_API_KEY=your_secret_ingestion_key_here
