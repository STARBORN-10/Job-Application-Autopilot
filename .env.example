# ===========================================================================
# Job Application Autopilot - Environment Configuration Template
# ---------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to '.env' (or 'backend/.env' and 'frontend/.env').
# 2. Replace placeholder values with your actual configuration.
# 3. NEVER commit real secrets or credentials to Git.
# ===========================================================================

# ---------------------------------------------------------------------------
# Backend Configuration
# ---------------------------------------------------------------------------
# Secret API key used by Make.com HTTP modules to authenticate requests to:
# - POST /api/jobs (save evaluated jobs)
# - GET /api/make/resume (retrieve resume for a role)
# - GET /api/make/context (retrieve active role, resume text, and filter settings)
#
# Must match the 'X-API-Key' header configured in Make.com.
MAKE_API_KEY=your_secret_make_api_key_here
# Database connection URL:
# Local development default (SQLite):
DATABASE_URL=sqlite:///./jobs.db
# Production (e.g. Render PostgreSQL / Supabase / Neon):
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Port (optional, default 8000):
# PORT=8000

# ---------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ---------------------------------------------------------------------------
# Base URL for backend API requests made from the React dashboard:
# Local development:
VITE_API_URL=http://localhost:8000/api
# Production deployment:
# VITE_API_URL=https://job-application-autopilot.onrender.com/api
